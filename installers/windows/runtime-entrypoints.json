    {
      "id": "smeta-rag-readiness",
      "kind": "python_module",
      "target": "tools.smeta_rag_readiness",
      "required_files": ["tools/smeta_rag_readiness.py"],
      "callsites": ["tools/smeta_generation_coordinator.py"]
