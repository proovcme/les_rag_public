<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.ovc.les.mlx</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ovc/Projects/LES_v2/.venv/bin/python3</string>
        <string>/Users/ovc/Projects/LES_v2/mlx_host.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ovc/Projects/LES_v2</string>

    <!-- P0: Qwen collection must never receive legacy BGE query vectors. These
         non-secret values win over stale .env entries because mlx_host loads
         .env with setdefault(). -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>LES_EMBED_PROFILE</key>
        <string>qwen</string>
        <key>EMBEDDING_MODEL</key>
        <string>Qwen/Qwen3-Embedding-0.6B</string>
        <key>EMBED_MODEL</key>
        <string>qwen3-embedding-0.6b</string>
        <key>EMBED_BACKEND</key>
        <string>coreml</string>
        <key>COREML_EMBED_MODEL</key>
        <string>artifacts/coreml/qwen3_embedding_06b_b1_s512_static.mlpackage</string>
        <key>COREML_EMBED_SEQ_LEN</key>
        <string>512</string>
        <key>COREML_EMBED_BATCH_SIZE</key>
        <string>1</string>
        <key>COREML_EMBED_COMPUTE_UNITS</key>
        <string>cpu_and_gpu</string>
        <key>COREML_EMBED_ISOLATE_PROCESS</key>
        <string>true</string>
        <key>COREML_EMBED_LOCAL_FILES_ONLY</key>
        <string>true</string>
        <key>COREML_EMBED_FALLBACK</key>
        <string>false</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ovc/Projects/LES_v2/logs/mlx_host.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ovc/Projects/LES_v2/logs/mlx_host.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
