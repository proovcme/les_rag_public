# LES_v2 — Шаблон локальных и CI переменных окружения для тестирования
# НЕ СОДЕРЖИТ реальных паролей, токенов и ключей доступа.

# ── Бэкенд и Сеть ──────────────────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
MLX_URL=http://127.0.0.1:8080
PROXY_PORT=8050
SOVUSHKA_PORT=8051

# ── Пути к тестовым БД и хранилищу ────────────────────────────
RAG_META_DB_PATH=data/test_les_meta.db
RAG_SMETA_STRUCTURED_DB_PATH=data/test_les_smeta_structured.db
RAG_CONTENT_DIR=RAG_Content

# ── Настройки моделей и таймаутов ──────────────────────────────
LLM_MODEL=qwen2.5-coder-7b-instruct
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_BACKEND=cross_encoder
LES_HEALTH_TIMEOUT_SEC=5.0

# ── Безопасность и CORS (Тестовые ключи) ──────────────────────
JWT_SECRET=change_me_for_test_environment_key
CORS_ALLOWED_ORIGINS=http://localhost:8050,http://localhost:8051,http://127.0.0.1:8050,http://127.0.0.1:8051

# ── Флаги тестового окружения ─────────────────────────────────
TESTING=true
CI=true
