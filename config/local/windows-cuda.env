# Windows runtime overrides for LES smeta (not secrets).
# Loaded by scripts/windows/LES-START.ps1 before start-light.
# Completeness profile: canonical SPB pricebook + local global review on.
# Primary local tool model for norm selection on 16GB VRAM (Q4_K_M).
LES_OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
LES_SMETA_QWEN_MODEL=qwen2.5:14b-instruct-q4_K_M
LES_SMETA_DOCUMENT_MODEL=qwen2.5:14b-instruct-q4_K_M
LES_SMETA_DOCUMENT_NUM_CTX=8192
# Embeddings: keep Ollama bge-m3 aligned with the local les_rag index-contract.
EMBED_BACKEND=ollama
EMBEDDING_MODEL=bge-m3
EMBED_MODEL=bge-m3:latest
RAG_VECTOR_SIZE=1024
RERANK_DEVICE=cuda
RERANKER_ENABLED=true
RERANKER_BACKEND=sentence_transformers
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Canonical default after surgical baseline gap fill (FSEM + SPB parquet).
LES_DEFAULT_PRICEBOOK=sankt-peterburg_2kv2026
LES_SMETA_DOCUMENT_BATCH_SIZE=1
LES_SMETA_DOCUMENT_MAPPING_MAX_TOKENS=8000
LES_SMETA_DOCUMENT_MAX_TOOL_TURNS=10
LES_SMETA_MAPPING_EVIDENCE_REPAIR_TURNS=1
LES_SMETA_LOCAL_GLOBAL_REVIEW=1
LES_SMETA_CANDIDATE_DRAFT_MODE=on
LES_SMETA_DOCUMENT_SOFT_ACCEPT=1
LES_SMETA_DOCUMENT_TEMPERATURE=0.0
LES_SMETA_DOCUMENT_TOP_P=1.0
LES_SMETA_DOCUMENT_SEED=0
LES_SMETA_NORM_RERANK=true
LES_SMETA_SEARCH_BUDGET=3
LES_SMETA_READ_BUDGET=3
# Autonote off: operator phrases like "export table without gaps" must stay in chat.
LES_AUTONOTE_ENABLED=false
# ETM Product API (commercial quotes → KAC). Secrets live in
# config/local/secrets.env (gitignored). Do not put passwords here.
