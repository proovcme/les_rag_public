# Windows runtime overrides for LES smeta (not secrets).
# Loaded by scripts/windows/LES-START.ps1 before start-light.
RERANK_DEVICE=cuda
RERANKER_ENABLED=true
RERANKER_BACKEND=sentence_transformers
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LES_SMETA_DOCUMENT_BATCH_SIZE=1
LES_SMETA_DOCUMENT_MAPPING_MAX_TOKENS=8000
LES_SMETA_DOCUMENT_MAX_TOOL_TURNS=6
LES_SMETA_DOCUMENT_GLOBAL_REVIEW=0
LES_SMETA_DOCUMENT_SOFT_ACCEPT=1
# Fresh-run sampling seed for Ollama document/mapping exchange (not a mapping cache).
LES_SMETA_DOCUMENT_SEED=0
# Команды вроде «выгрузи таблицу … — без пропусков» ложно уходили в авто-заметку.
LES_AUTONOTE_ENABLED=false
