{
  "schema": "les.smeta.retrieval-vocabulary.v1",
  "rules": [
    {
      "id": "emergency_lighting_power_unit",
      "match_any": ["бап", "блок аварийного питания", "аварийного питания светильника"],
      "query": "отдельно устанавливаемый преобразователь или блок питания"
    },
    {
      "id": "indoor_corrugated_conduit",
      "match_any": ["гофрированн", "гофра пвх"],
      "query": "труба гофрированная ПВХ для защиты проводов и кабелей по стенам колоннам потолкам"
    },
    {
      "id": "primer_coating",
      "match_any": ["грунтован", "грунтовка потолка", "грунтовка стен"],
      "query": "покрытие поверхностей грунтовкой глубокого проникновения"
    },
    {
      "id": "structured_cabling",
      "match_any": ["скс", "структурированная кабельная система", "категории 5", "категории 6"],
      "stages": ["norm"],
      "queries": [
        "прокладка кабеля масса до 1 кг по стене внутри здания",
        "кабель по установленным конструкциям и лоткам масса до 2 кг"
      ]
    },
    {
      "id": "telecommunications_cabinet",
      "match_any": ["телекоммуникационн", "серверн", "шкаф 19", "42u"],
      "stages": ["collection", "norm"],
      "query": "шкаф коммутационный оборудование связи"
    },
    {
      "id": "patch_panel",
      "match_any": ["патч-панел", "патч панел", "patch panel"],
      "query": "монтаж кросса кроссировка линий панель коммутации"
    },
    {
      "id": "data_outlet",
      "match_any": ["rj45", "информационная розетка", "сетевая розетка"],
      "query": "установка абонентской телефонной розетки устройство связи"
    }
  ]
}
